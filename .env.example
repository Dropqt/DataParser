# Kopiraj u .env i popuni pravim podacima.
#   cp .env.example .env
#
# Ovaj fajl ne mora da se uredjuje rukom: sve sto je ovde stoji i u aplikaciji, u
# meniju Alatke -> Podesavanja (Ctrl+,). Snimanje odande cuva ove komentare.
#
# .env je u .gitignore i NIKAD ne sme da ode na GitHub.
# Aplikacija pri pokretanju proverava da .env nije u git indeksu i upozorava ako jeste.

# POTPIS je slika koja se utiskuje u vaucere prijavljene tim nalogom. Napravi je od
# screenshot-a ili skena ovako:
#   .venv/bin/python run.py --pripremi-potpis ~/Slike/potpis.png potpisi/majka.png
# Folder potpisi/ je u .gitignore. Prazno = vauceri ostaju nepotpisani.

# ---- Nalog 1 ----
ETURISTA_NALOG1_NAZIV=majka
ETURISTA_NALOG1_USER=
ETURISTA_NALOG1_PASS=
ETURISTA_NALOG1_POTPIS=

# ---- Nalog 2 ----
ETURISTA_NALOG2_NAZIV=mileta
ETURISTA_NALOG2_USER=
ETURISTA_NALOG2_PASS=
ETURISTA_NALOG2_POTPIS=

# ---- Nalog 3 ----
ETURISTA_NALOG3_NAZIV=treci
ETURISTA_NALOG3_USER=
ETURISTA_NALOG3_PASS=
ETURISTA_NALOG3_POTPIS=

# ---- Podesavanja ----
# Osnovni URL portala
ETURISTA_URL=https://www.portal.eturista.gov.rs

# Gde se snimaju PDF vauceri (podrazumevano: ./vauceri)
ETURISTA_PDF_DIR=

# Adresa na koju se salju vauceri. Unutar ETURISTA_PDF_DIR se pravi folder sa ovim
# imenom, pa se cela grupa kasnije zakaci iz jednog mesta. Gost koji u koloni E-mail
# ima svoju adresu ide u svoj folder. Prazno = svi vauceri zajedno, bez foldera.
# Menja se i u samoj aplikaciji, u traci iznad tabele.
ETURISTA_EMAIL=

# Gde se snimaju screenshot-ovi gresaka (podrazumevano: ./screenshots)
ETURISTA_SCREENSHOT_DIR=

# ---- Polozaj potpisa u vauceru ----
# Sve u milimetrima, mereno od natpisa POTPIS UGOSTITELJA. Podrazumevane vrednosti su
# izmerene na pravom vauceru i ne treba ih dirati dok ministarstvo ne promeni obrazac.
# Ako zatreba, prvo pogledaj gde bi potpis pao:
#   .venv/bin/python run.py --kalibracija "vauceri/2026_PETROVIC_MARKO.pdf"
# Visina potpisa (12.0). Vise od ovoga pocinje da udara u natpis iznad.
ETURISTA_POTPIS_VISINA=
# Vodoravno, od pocetka natpisa do SREDINE potpisa (26.4)
ETURISTA_POTPIS_POMAK_X=
# Nanize, od osnovne linije natpisa do DONJE IVICE potpisa (14.5). Crta je na 10.9,
# pa potpis prelazi malo preko nje - tako izgleda i kad se potpisuje rukom.
ETURISTA_POTPIS_POMAK_Y=
# Najveca dozvoljena sirina (50.0). Crta je duga 52 mm.
ETURISTA_POTPIS_MAX_SIRINA=

# Putanja do SQLite baze (podrazumevano: ./eturista.db)
ETURISTA_DB=

# Godina koja ide u naziv PDF fajla (podrazumevano: tekuca godina)
ETURISTA_GODINA=

# true = browser radi bez prozora. Za normalan rad ostavi false.
ETURISTA_HEADLESS=false

# Pri pokretanju proveri ima li novija verzija na GitHub-u. Salje se obican zahtev ka
# javnom repou, nista o tebi ni o gostima se ne prenosi. false = iskljuceno.
ETURISTA_PROVERA_AZURIRANJA=true
