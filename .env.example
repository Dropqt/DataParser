# Kopiraj u .env i popuni pravim podacima.
#   cp .env.example .env
#
# .env je u .gitignore i NIKAD ne sme da ode na GitHub.
# Aplikacija pri pokretanju proverava da .env nije u git indeksu i upozorava ako jeste.

# ---- Nalog 1 ----
ETURISTA_NALOG1_NAZIV=majka
ETURISTA_NALOG1_USER=
ETURISTA_NALOG1_PASS=

# ---- Nalog 2 ----
ETURISTA_NALOG2_NAZIV=mileta
ETURISTA_NALOG2_USER=
ETURISTA_NALOG2_PASS=

# ---- Nalog 3 ----
ETURISTA_NALOG3_NAZIV=treci
ETURISTA_NALOG3_USER=
ETURISTA_NALOG3_PASS=

# ---- Podesavanja ----
# Osnovni URL portala
ETURISTA_URL=https://www.portal.eturista.gov.rs

# Gde se snimaju PDF vauceri (podrazumevano: ./vauceri)
ETURISTA_PDF_DIR=

# Adresa na koju se salju vauceri. Unutar ETURISTA_PDF_DIR se pravi folder sa ovim
# imenom, pa se cela grupa kasnije zakaci iz jednog mesta. Gost koji u koloni E-mail
# ima svoju adresu ide u svoj folder. Prazno = svi vauceri zajedno, bez foldera.
# Menja se i u samoj aplikaciji, u traci iznad tabele.
ETURISTA_EMAIL=

# Gde se snimaju screenshot-ovi gresaka (podrazumevano: ./screenshots)
ETURISTA_SCREENSHOT_DIR=

# Putanja do SQLite baze (podrazumevano: ./eturista.db)
ETURISTA_DB=

# Godina koja ide u naziv PDF fajla (podrazumevano: tekuca godina)
ETURISTA_GODINA=

# true = browser radi bez prozora. Za normalan rad ostavi false.
ETURISTA_HEADLESS=false

# Pri pokretanju proveri ima li novija verzija na GitHub-u. Salje se obican zahtev ka
# javnom repou, nista o tebi ni o gostima se ne prenosi. false = iskljuceno.
ETURISTA_PROVERA_AZURIRANJA=true
